  "links": [],
  "panels": [
    {
      "id": 1,
      "type": "piechart",
      "title": "Productos En Stock / Sin Stock",
      "description": "Productos activos con stock > 0 frente a stock = 0",
      "gridPos": { "h": 9, "w": 8, "x": 0, "y": 0 },
      "datasource": { "type": "mysql", "uid": "mysql-sweetcode" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "hideFrom": { "legend": false, "tooltip": false, "viz": false }
          },
          "mappings": [],
          "unit": "short"
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "en_stock" },
            "properties": [
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "green" } }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "sin_stock" },
            "properties": [
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "values": ["value", "percent"]
        },
        "pieType": "donut",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        },
        "displayLabels": ["name", "percent"]
      },
      "targets": [
        {
          "datasource": { "type": "mysql", "uid": "mysql-sweetcode" },
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT CASE WHEN stock > 0 THEN 'en_stock' ELSE 'sin_stock' END AS estado, COUNT(*) AS total FROM productos WHERE activo = 1 GROUP BY CASE WHEN stock > 0 THEN 'en_stock' ELSE 'sin_stock' END;",
          "editorMode": "code"
        }
      ]
    },
    {
      "id": 2,
      "type": "table",
      "title": "Producto Mas Vendido",
      "description": "Producto con mas unidades vendidas segun lineas_pedido",
      "gridPos": { "h": 9, "w": 8, "x": 8, "y": 0 },
      "datasource": { "type": "mysql", "uid": "mysql-sweetcode" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "custom": {
            "align": "auto",
            "cellOptions": { "type": "auto" },
            "inspect": false
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null }
            ]
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "unidades_vendidas" },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": { "type": "color-text", "mode": "basic" }
              },
              {
                "id": "color",
                "value": { "mode": "continuous-GrYlRd" }
              },
              {
                "id": "custom.width",
                "value": 150
              }
            ]
          }
        ]
      },
      "options": {
        "cellHeight": "md",
        "footer": { "countRows": false, "fields": "", "reducer": ["sum"], "show": false },
        "showHeader": true
      },
      "targets": [
        {
          "datasource": { "type": "mysql", "uid": "mysql-sweetcode" },
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT pr.nombre AS producto, COALESCE(SUM(lp.cantidad), 0) AS unidades_vendidas FROM productos pr LEFT JOIN lineas_pedido lp ON lp.id_producto = pr.id_producto WHERE pr.activo = 1 GROUP BY pr.id_producto, pr.nombre ORDER BY unidades_vendidas DESC LIMIT 1;",
          "editorMode": "code"
        }
      ]
    },
    {
      "id": 3,
      "type": "table",
      "title": "Producto Menos Vendido",
      "description": "Producto con menos unidades vendidas segun lineas_pedido (incluye los que nunca se han vendido)",
      "gridPos": { "h": 9, "w": 8, "x": 16, "y": 0 },
      "datasource": { "type": "mysql", "uid": "mysql-sweetcode" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "custom": {
