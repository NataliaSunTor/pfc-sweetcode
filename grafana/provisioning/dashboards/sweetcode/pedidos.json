      "targets": [
        {
          "datasource": { "type": "mysql", "uid": "mysql-sweetcode" },
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT p.id_pedido, CONCAT(u.nombre, ' ', u.apellidos) AS cliente, p.fecha, p.estado, p.importe_total, p.observaciones FROM pedidos p JOIN usuarios u ON u.id_usuario = p.id_usuario WHERE p.estado IN ('pendiente', 'en_preparacion') ORDER BY p.fecha DESC;",
